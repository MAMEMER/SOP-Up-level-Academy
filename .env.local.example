NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# StoreHub Supply Needs auto-alert (optional). ลิงก์ export ของ Supply Needs
# (JSON หรือ CSV) จาก StoreHub backoffice หรือ Google Sheet ที่ publish เป็น CSV.
# ตั้งค่าแล้ว SOP จะดึงรายการสินค้าใกล้หมดมาแจ้งพนักงานอัตโนมัติ ไม่ต้อง copy CSV เอง.
STOREHUB_SUPPLY_NEEDS_URL=
# ถ้า feed ต้องใช้ token (ส่งเป็น Bearer). เว้นว่างได้ถ้าลิงก์เป็น public.
STOREHUB_SUPPLY_NEEDS_TOKEN=
# ทางเลือก: ถ้าชี้ URL ไปที่ backoffice XHR endpoint ของ StoreHub โดยตรง ให้วาง
# session cookie ที่ copy จาก browser (DevTools → Network → คำขอ supplyNeeds → Cookie).
# หมดอายุตาม session จึงต้องอัปเดตเป็นครั้งคราว. เว้นว่างถ้าใช้ export/Google Sheet.
STOREHUB_SUPPLY_NEEDS_COOKIE=
